# Copy to .env.local and fill in. Never commit real values.
# Every variable is described in README.md, "Environment variables".

# Required
DATABASE_URL=
AUTH_SECRET=
# Digits only, with the country code, no "+": 2126XXXXXXXX
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Required in production (optional on Vercel, which provides its own URL)
# The public address, no trailing slash: https://example.com
NEXT_PUBLIC_SITE_URL=

# Only when hosting outside Vercel or Cloudflare
# AUTH_TRUST_HOST=true

# Optional: email Nouhad on each new order (Resend)
RESEND_API_KEY=
ADMIN_NOTIFY_EMAIL=
RESEND_FROM=
